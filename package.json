{
  "name": "schedule-relay",
  "version": "0.1.0",
  "private": true,
  "description": "スケ調くん（Spir全機能＋リレー型T6）",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate resolve --rolled-back 0001_init 2>/dev/null || true && prisma migrate deploy",
    "start": "npm run db:deploy && next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "googleapis": "^173.0.0",
    "next": "^15.1.3",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
