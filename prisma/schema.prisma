// スケジュール調整ツール データモデル（仕様 §8）
// ダブルブッキング防止の要 = Hold の EXCLUDE 制約は Prisma で表現できないため
// prisma/migrations/0001_init/migration.sql の生SQLで付与する（仕様 §12 強化）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdjustmentType {
  T1
  T2
  T3
  T4
  T5
  T6
}

enum EventStatus {
  draft
  open
  holding
  confirmed
  closed
  expired
  cancelled
}

enum HoldStatus {
  active
  released
  confirmed
}

enum RelaySubMode {
  converge
  chained
  independent
}

enum RelayStepStatus {
  waiting
  active
  done
  skipped
}

model BookingPage {
  id          String         @id @default(cuid())
  organizerId String
  type        AdjustmentType
  slug        String         @unique
  isActive    Boolean        @default(true)
  settings    Json // §10 settings スキーマ
  createdAt   DateTime       @default(now())
  events      Event[]
}

model Event {
  id             String         @id @default(cuid())
  pageId         String
  page           BookingPage    @relation(fields: [pageId], references: [id])
  type           AdjustmentType
  status         EventStatus    @default(open)
  idempotencyKey String?        @unique // §7-6 冪等
  createdAt      DateTime       @default(now())
  candidates     Candidate[]
  holds          Hold[]
  confirmations  Confirmation[]
  relaySteps     RelayStep[]
  votes          Vote[]
}

model Candidate {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id])
  // UTC 保存・15分グリッド（§7-1/§7-2）
  startAt DateTime
  endAt   DateTime
  holds   Hold[]

  @@unique([eventId, startAt, endAt]) // 同一(event,slot)は1行に正規化（upsert race防止）
  @@index([eventId])
}

model Hold {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id])
  candidateId String
  candidate   Candidate  @relation(fields: [candidateId], references: [id])
  resourceId  String // 主催者枠 or 会議室など共有リソース
  holderId    String
  startAt     DateTime
  endAt       DateTime
  status      HoldStatus @default(active)
  expiresAt   DateTime // TTL（既定15分）
  createdAt   DateTime   @default(now())

  // ★ ダブルブッキング物理防止は migration.sql の EXCLUDE 制約で担保：
  //   EXCLUDE USING gist (resource_id WITH =, tstzrange(start_at, end_at) WITH &&)
  //   WHERE (status = 'active')
  @@index([eventId])
  @@index([resourceId, status])
}

model Confirmation {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  participantId String
  startAt       DateTime
  endAt         DateTime
  formAnswers   Json? // §6 予約フォーム回答
  confirmedAt   DateTime @default(now())

  @@index([eventId])
}

model RelayStep {
  id         String          @id @default(cuid())
  eventId    String
  event      Event           @relation(fields: [eventId], references: [id])
  order      Int
  assigneeId String
  subMode    RelaySubMode    @default(converge)
  status     RelayStepStatus @default(waiting)
  deadline   DateTime?
  slotStart  DateTime?
  slotEnd    DateTime?

  @@unique([eventId, order])
  @@index([eventId])
}

model Vote {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  candidateId String
  voterId     String
  createdAt   DateTime @default(now())

  @@unique([eventId, candidateId, voterId]) // 二重投票防止
  @@index([eventId])
}

model Resource {
  id       String @id @default(cuid())
  kind     String // "room" | "web_conf" | "organizer"
  name     String
  capacity Int    @default(1)
}

/// 🔴 リレー型 T6 候補リンク（A→B→C 順番調整・Spirとの差別化機能）。
/// 採用面接など「一次面接担当A → 二次面接担当B → 最終面接担当C」を、
/// 順番付き連続候補で確保するためのリンク。Linkテーブル(BookingPage)とは独立した
/// 軽量モデル（複数owner・stages JSON）。仮押さえはGoogle側に provisional ホールド。
model RelayLink {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  durationMinutes Int
  /// 作成した主催者（User.id）。カレンダー資格情報はこの列からのみ解決する。
  /// stages[].ownerEmail は表示用の文字列であり、**信頼してはいけない**
  /// （2026-08-08 レビュー H2：他人のメールを書いて他人のカレンダーを読み書きされた）。
  /// 既存行は null（＝カレンダー連携オフで degrade-safe）。
  createdByUserId String?
  /// [{order:1,label:"A",ownerEmail:"a@…",calendarIds:["primary"]}, ...]
  stages          Json
  bufferMinutes   Int      @default(15)
  maxGapDays      Int      @default(14)
  startDate       DateTime?
  endDate         DateTime?
  status          String   @default("open") // open | closed
  createdAt       DateTime @default(now())
  holds           RelayLinkHold[]

  @@index([createdByUserId])
}

/// リレー仮押さえ。order=stage番号、各ステージ枠1行ずつ。
/// 同一RelayLink内のdedupは (relayLinkId, stageOrder, startAt) のユニークで担保。
model RelayLinkHold {
  id            String    @id @default(cuid())
  relayLinkId   String
  relayLink    RelayLink @relation(fields: [relayLinkId], references: [id])
  stageOrder    Int
  stageLabel    String
  ownerEmail    String
  startAt       DateTime
  endAt         DateTime
  /// Googleカレンダーイベントを作った場合のID（degrade-safe: null可）
  googleEventId String?
  status        String    @default("provisional") // provisional | released | confirmed
  createdAt     DateTime  @default(now())

  @@unique([relayLinkId, stageOrder, startAt])
  @@index([relayLinkId])
}

/// AIタイトル生成の学習用履歴。使われたタイトルを蓄積して次回の候補精度を上げる。
model TitleHistory {
  id        String   @id @default(cuid())
  title     String
  context   String?  // ヒント（"Eight","名刺","LinkedIn"など）
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) 標準スキーマ — @auth/prisma-adapter が要求する4モデル。
// セッション戦略は JWT（middleware が Edge で検証するため）だが、Adapter を渡すと
// Auth.js は戦略に関わらず User / Account を DB に永続化する
// （@auth/core/lib/actions/callback/index.js: handleLoginOrRegister は jwt 分岐の前）。
// → Account.refresh_token に各ユーザーの Google リフレッシュトークンが入り、
//   マルチテナントのカレンダー連携（src/service/calendar/tenant.ts）がこれを読む。
// ---------------------------------------------------------------------------

/// ログインした主催者。BookingPage.organizerId / RelayLink の所有者は User.id を指す。
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
}

/// OAuth プロバイダごとの資格情報。Google の refresh_token はここに入る。
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// database セッション戦略用（現在は JWT 運用なので未使用だが Adapter の型が要求する）。
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// メールリンク認証用（現在は Google のみなので未使用だが Adapter の型が要求する）。
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id      String   @id @default(cuid())
  eventId String?
  actorId String
  action  String
  before  Json?
  after   Json?
  at      DateTime @default(now()) // 追記専用（§18）

  @@index([eventId])
}
